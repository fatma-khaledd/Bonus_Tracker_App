rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Users cannot delete their accounts directly
    }

    // -------------------------------------------------------------------------
    // Committees & Subcollections
    // -------------------------------------------------------------------------
    match /committees/{committeeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // To be refined with role-based checks

      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // -------------------------------------------------------------------------
    // Notes Collection (Shared: Personal + HR Notes)
    // -------------------------------------------------------------------------
    match /notes/{noteId} {
      // READ:
      // - Personal notes: STRICTLY readable only by the owner (no leaks to other members).
      // - HR notes: Readable by authenticated members.
      allow read: if isAuthenticated() && (
        (resource.data.type == 'personal' && resource.data.ownerId == request.auth.uid) ||
        (resource.data.type == 'hr')
      );

      // CREATE:
      // - User can only create notes where ownerId matches their own auth UID.
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;

      // UPDATE & DELETE:
      // - The note owner can update or delete their note.
      allow update, delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Notifications Collection
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.targetUserId == null
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.targetUserId == request.auth.uid;
      allow delete: if false;
    }
  }
}
